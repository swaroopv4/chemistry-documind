APP_DOMAIN=your-public-hostname.example
TLS_EMAIL=admin@uci.edu
GROQ_API_KEY=your_groq_key
PINECONE_API_KEY=your_pinecone_key
GROQ_MODEL=openai/gpt-oss-20b
PINECONE_INDEX_NAME=documind-groq
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
ADMIN_EMAILS=admin@uci.edu
OIDC_PROVIDER=google
OIDC_CLIENT_ID=replace_with_google_client_id
OIDC_CLIENT_SECRET=replace_with_google_client_secret
OIDC_COOKIE_SECRET=replace_with_at_least_32_random_characters
BROKER_REDIS_PASSWORD=replace_with_random_url_safe_password
CACHE_REDIS_PASSWORD=replace_with_different_random_url_safe_password
USER_RATE_LIMIT_PER_MINUTE=20
GUARDRAILS_ENABLED=true
CACHE_ENABLED=true
MIN_RETRIEVAL_SCORE=0.25
OBSERVABILITY_ENABLED=true
RAGAS_GROQ_MODEL=openai/gpt-oss-20b
