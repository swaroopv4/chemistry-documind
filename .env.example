GROQ_API_KEY=your_groq_key
PINECONE_API_KEY=your_pinecone_key
GROQ_MODEL=openai/gpt-oss-20b
PINECONE_INDEX_NAME=documind-groq
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
GUARDRAILS_ENABLED=true
MIN_RETRIEVAL_SCORE=0.25
RETRIEVAL_MODE=hybrid
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600
CACHE_INVALIDATION_DELAY_SECONDS=30
BASELINE_WINDOW=50
DRIFT_THRESHOLD=0.15
RAGAS_GROQ_MODEL=openai/gpt-oss-20b
# DOCUMIND_DATA_DIR defaults to this application's data folder.
# EVAL_LOG_FILE and RAGAS_REPORT_DIR can override their default paths.
OBSERVABILITY_ENABLED=true
# DOCUMIND_DB defaults to DOCUMIND_DATA_DIR/documind.db (shared by app and worker).
# GROQ_PRICES_JSON={"openai/gpt-oss-20b":[0.075,0.30],"openai/gpt-oss-120b":[0.15,0.60]}
# Prices are USD per million input/output tokens, standard on-demand tier.
PINECONE_EMBEDDING_USD_PER_MILLION=0.16
ANSWER_CACHE_REDIS_URL=redis://127.0.0.1:6380/0
USER_RATE_LIMIT_PER_MINUTE=20
ADMIN_EMAILS=admin@uci.edu
OIDC_PROVIDER=google
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_COOKIE_SECRET=
OIDC_REDIRECT_URI=http://localhost:8501/oauth2callback
DEPLOYMENT_ENV=local
# DOCUMIND_LOCAL_ADMIN=true is only for a loopback-bound local preview.
# It is automatically ignored when OIDC credentials are configured, and forbidden in production.
